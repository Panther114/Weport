# ---- Server ----
# Railway injects PORT automatically; local default:
PORT=8080
# Persistent data dir (meta.json + blobs/). On Railway mount a Volume here.
WECLONE_DATA_DIR=./data

# ---- LLM proxy (OpenAI-compatible; server-side key, never sent by clients) ----
# Default = OpenCode Go 订阅网关（与 WeportAI 客户端一致）；以 /v1 结尾直接拼
# /chat/completions，裸域名则自动补 /v1。自建网关时才需要覆盖。
WECLONE_LLM_BASE_URL=https://opencode.ai/zen/go/v1
# Leave empty to run in mock mode ("[Mock WeClone] ..." echo replies)
WECLONE_LLM_API_KEY=
WECLONE_LLM_MODEL=muse-spark-1.2-contributor
WECLONE_LLM_MAX_TOKENS=1024

# ---- Limits ----
# Max upload body per request (MB)
WECLONE_MAX_UPLOAD_MB=25
# Max serialized chunks per clone (MB)
WECLONE_MAX_BLOB_MB=20
# Max clones per owner token
WECLONE_MAX_CLONES_PER_TOKEN=5
# Chat rate limit per IP (requests / minute)
WECLONE_RATE_LIMIT_CHAT=20
# Upload rate limit per IP (requests / hour)
WECLONE_RATE_LIMIT_UPLOAD=5
# Server-side severe-PII hit threshold — more hits than this rejects the upload (400)
WECLONE_PII_MAX_HITS=5

# ---- CORS ----
# * = reflect any origin (fine for the public website); tighten for production if desired
# Fixed service https://weport.up.railway.app is always allowed (appended automatically when list is set)
CORS_ALLOW_ORIGINS=*

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Weport",
  "version": "0.1.0",
  "identifier": "com.weport.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Weport",
        "width": 440,
        "height": 700,
        "minWidth": 400,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://github.com https://api.github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Lightweight WeChat chat history exporter",
    "longDescription": "Weport exports WeChat 4.x local chat history for every contact and group chat to TXT or JSON on Windows.",
    "copyright": "Copyright © 2026 Weport",
    "publisher": "Weport",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/native/win32/x64/**/*"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "",
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Weport"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBNEJBQkRGRTg0MzlFRjcKUldUM25rUG8zNnRMdXAxMUNxQVR6QXc0OWlJbi9CN2J3ZXBlQ3B6SjZLelNGNjV2ZXUrOHUzSU4K",
      "endpoints": [
        "https://github.com/Panther114/Weport/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"]
  },
  "include": [
    "vite.config.mts",
    "electron/**/*.ts",
    "electron/**/*.d.ts"
  ]
}

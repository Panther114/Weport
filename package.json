{
  "name": "weport",
  "version": "0.8.2",
  "private": true,
  "description": "Weport — WeChat chat history exporter (Electron + React + native engine)",
  "author": {
    "name": "Panther114",
    "email": "panther114@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Panther114/Weport"
  },
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps && node scripts/prepare-electron-runtime.cjs",
    "dev": "node scripts/prepare-electron-runtime.cjs && vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "node scripts/clean-dist-electron.cjs && tsc --noEmit && vite build && electron-builder --publish never",
    "build:dir": "node scripts/clean-dist-electron.cjs && tsc --noEmit && vite build && electron-builder --dir --publish never",
    "package": "node scripts/clean-dist-electron.cjs && vite build && electron-builder --publish never"
  },
  "dependencies": {
    "@hicccc77/electron-liquid-glass": "^0.3.0",
    "@vscode/sudo-prompt": "^9.3.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "fzstd": "^0.1.1",
    "koffi": "^3.1.0",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.7",
    "silk-wasm": "^3.7.1",
    "wechat-emojis": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-electron": "^1.1.0"
  },
  "build": {
    "appId": "com.weport.desktop",
    "productName": "Weport",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Panther114",
        "repo": "Weport",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icons/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "Weport-${version}-${arch}.${ext}",
      "icon": "resources/icons/macos/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "resources/wcdb/macos/universal",
          "to": "resources/wcdb/macos/universal"
        },
        {
          "from": "resources/key/macos/universal",
          "to": "resources/key/macos/universal"
        },
        {
          "from": "resources/wedecrypt/macos/${arch}",
          "to": "resources/wedecrypt/macos/${arch}"
        },
        {
          "from": "resources/welive/macos/${arch}",
          "to": "resources/welive/macos/${arch}",
          "filter": [
            "**/*",
            "!**/*.framework",
            "!**/*.framework/**/*"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Weport-${version}-Setup.${ext}",
      "icon": "assets/icons/icon.png",
      "extraFiles": [
        {
          "from": "resources/runtime/win32/msvcp140.dll",
          "to": "."
        },
        {
          "from": "resources/runtime/win32/msvcp140_1.dll",
          "to": "."
        },
        {
          "from": "resources/runtime/win32/vcruntime140.dll",
          "to": "."
        },
        {
          "from": "resources/runtime/win32/vcruntime140_1.dll",
          "to": "."
        }
      ],
      "extraResources": [
        {
          "from": "resources/wcdb/win32/${arch}",
          "to": "resources/wcdb/win32/${arch}"
        },
        {
          "from": "resources/key/win32",
          "to": "resources/key/win32",
          "filter": [
            "${arch}/**/*"
          ]
        },
        {
          "from": "resources/wedecrypt/win32/${arch}",
          "to": "resources/wedecrypt/win32/${arch}"
        },
        {
          "from": "resources/runtime/win32",
          "to": "resources/runtime/win32"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "unicode": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "displayLanguageSelector": false,
      "perMachine": false,
      "allowElevation": true,
      "shortcutName": "Weport"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/@hicccc77/electron-liquid-glass/**/*",
      "node_modules/koffi/**/*",
      "node_modules/silk-wasm/**/*",
      "resources/wedecrypt/**/*.node"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "npmRebuild": false
  }
}

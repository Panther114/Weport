{
  "name": "weport",
  "version": "0.0.1",
  "private": true,
  "description": "Weport — lightweight WeChat chat history exporter for Windows (CLI + GUI)",
  "author": {
    "name": "Panther114",
    "email": "panther114@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Panther114/Weport"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "bin": {
    "weport": "scripts/weport-cli.cjs"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps && node scripts/prepare-electron-runtime.cjs",
    "dev:ui": "vite",
    "dev:engine": "node scripts/prepare-electron-runtime.cjs && vite build --config vite.engine.config.ts && electron dist-electron/main.js",
    "dev": "tauri dev",
    "build:ui": "tsc -p tsconfig.ui.json --noEmit && vite build",
    "build:engine": "node scripts/clean-dist-electron.cjs && vite build --config vite.engine.config.ts && node -e \"require('fs').accessSync('dist-electron/main.js')\"",
    "build:engine:pack": "npm run build:engine && electron-builder --config electron-builder.engine.json --win dir",
    "prepare:engine": "node scripts/prepare-engine-resources.cjs",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run build:ui && npm run build:engine",
    "build:release": "npm run icons && npm run build:engine:pack && npm run prepare:engine && npm run tauri:build",
    "cli": "node scripts/weport-cli.cjs",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "typecheck": "tsc -p tsconfig.ui.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "@vscode/sudo-prompt": "^9.3.2",
    "electron-store": "^11.0.2",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "fzstd": "^0.1.1",
    "koffi": "^3.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sherpa-onnx-node": "^1.13.3",
    "silk-wasm": "^3.7.1",
    "wechat-emojis": "^1.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@tauri-apps/cli": "^2.9.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0"
  },
  "overrides": {
    "brace-expansion": {
      ".": "^5.0.6"
    },
    "node-abi": ">=4.33.0",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "fast-uri": "^3.1.3",
    "form-data": "^4.0.6",
    "ip-address": "^10.2.0",
    "picomatch": "^4.0.4",
    "js-yaml": "^4.3.0",
    "tar": "^7.5.19",
    "tmp": "^0.2.7",
    "immutable": "^5.1.5"
  }
}
